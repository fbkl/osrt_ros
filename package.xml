<?xml version="1.0"?>
<package format="2">
  <name>osrt_ros</name>
  <version>0.0.1</version>
  <description>osrt_ros publishes the ros topics for the opensimrt_core integration. 
See https://github.com/mysablehats/osrt_ros.git
  </description>

  <maintainer email="frekle@kth.se">Frederico Klein</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>opensimrt</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>opensimrt_msgs</build_depend>
  <build_depend>opensimrt_bridge</build_depend>
  <build_depend>tf</build_depend>
  <build_export_depend>opensimrt</build_export_depend>
  <build_export_depend>opensimrt_msgs</build_export_depend>
  <build_export_depend>opensimrt_bridge</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <exec_depend>opensimrt</exec_depend>
  <exec_depend>opensimrt_msgs</exec_depend>
  <exec_depend>opensimrt_bridge</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>tf</exec_depend>
  <depend>message_runtime</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>rviz</depend>
  <depend>urdf</depend>
  <depend>vicon_bridge</depend>
  <depend>pluginlib</depend>
  <depend>qtbase5-dev</depend>
  <export>
	  <rviz plugin="${prefix}/plugin_description.xml" />
  </export>
</package>

<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<launch>
	<include file="$(find vio_launch)/launch/includes/machines.xml"/>
	<!-- -->
	<arg name="freq"                        default="100" />
	<arg name="name_tag"                    default="lower" />
	<arg name="ik_node_name"                default="ik_$(arg name_tag)body_node"/>
	<arg name="tf_prefix"                   default=""/>
	<arg name="bypass_heading_computation"  default="false"/>
	<arg name="heading_debug"               default="0"/>
	<arg name="heading_offset"              default="0"/>
	<arg name="visualise"                   default="false" />
	<arg name="wait_to_start"       	default="false"/>
	<arg name="use_sim_time"        	default="false"/>
	<!--arg name="model_file"               default="/srv/data/gait1992/residual_reduction_algorithm/model_adjusted.osim" / -->
	<arg name="model"          		default="raquegopal" />
	<arg name="model_file"          	default="/srv/host_data/$(arg model)/$(arg model).osim" />
	<!-- =================================================================== -->
	<!--  📣 OI. FUTURE FREDERICO. THE CALIBRATION DANCE. READ IT. 📣        -->
	<!--     (written 2026-08-21 for the version of you that is running on   -->
	<!--      three hours of sleep and cannot be expected to re-derive this) -->
	<!-- =================================================================== -->
	<!--
	     ⛔⛔ FIRST, THE THING THAT WILL RUIN YOUR WEEK IF YOU SKIM: ⛔⛔

	         THE ROTATION AMOUNT BELOW IS ***PER MODEL***. IT IS NOT A CONSTANT.
	         IT IS NOT "THE FIX". IT IS NOT 90 DEG. IT IS *** WHATEVER THAT ONE
	         MODEL'S GROUND JOINT SAYS IT IS ***, AND FOR MOST MODELS IT IS ZERO.

	         THIS FILE DEFAULTS TO model=raquegopal. 👉 raquegopal NEEDS NO ROTATION. 👈
	         IF YOU DO THE MOBL DANCE ON raquegopal YOU WILL YAW IT 90 DEG WRONG AND
	         SPEND A DAY BLAMING IMUCalibrator. DO NOT. 🙅

	     ================== WHY THERE IS A DANCE AT ALL ==================

	     calibration assumes  R_BS = ~R_GoB_def * R_GoS , where R_GoB_def is captured at
	     the MODEL'S DEFAULT POSE (initSystem(), i.e. each coordinate's default_value).

	     ==> THE PHYSICAL THING MUST BE STANDING IN THE MODEL'S DEFAULT POSE WHEN YOU
	         HIT CALIBRATE. that is the whole rule. everything below is a consequence.

	     most models: default pose == zero pose == "facing the markers". NO DANCE. 🎉
	     MOBL_ARMS:   default pose is YAWED, because MOBL_ARMS_41.osim has

	              joint groundthorax, coordinate r_y, default_value = -1.5707963 rad
	                                                                 = >>> -90 deg <<<

	         and groundthorax is GROUND-ATTACHED, so that yaws THE ENTIRE MODEL.
	         THAT number, in THAT file, is the only reason MOBL needs turning. 🎯

	     ============ HOW TO KNOW, WITHOUT READING ANY .osim ============

	     IMUCalibrator::setup() ALREADY PRINTS THIS AT YOU. 📣 it fires a big red
	     ERROR BANNER naming the joint and the angle whenever a model has a non-zero
	     ROTATIONAL default on a GROUND-ATTACHED joint. (ERROR level on purpose: INFO
	     does not survive the paramiko/ssh launch path, see the logging note below.)

	         BANNER FIRES  -> that angle IS your dance. rotate the rig by it.
	         BANNER SILENT -> ✨ NO DANCE ✨. face the markers. calibrate. done.

	     iiwa__ : silent (every default is zero).           NO DANCE.
	     raquegopal : warn-list only — it has 17 non-zero defaults but they are all
	                  LEGS, none ground-attached, so no global yaw. NO DANCE. 🦵
	     MOBL   : SCREAMS. -90 deg. DANCE. 💃

	     ================= THE MOBL DANCE, AS PERFORMED =================
	                    (2026-08-21. worked. do not re-derive.)

	       1. calibrate the CAMERAS with the rig facing the WALL MARKERS.
	       2. rotate the test rig to MOBL's default pose (see sign note). 🔄
	       3. calibrate IK.

	     the wrong turn, so you do not repeat it:
	       tried +90 first  -> cameras landed on the WRONG SIDE of the body...
	                           ⚠️ ...BUT THE MOVEMENT WAS CORRECT. ⚠️
	                           READ THAT TWICE. right movement + wrong placement
	                           == A SIGN ERROR, *NOT* A BROKEN CALIBRATION.
	                           DO NOT GO REWRITE IMUCalibrator. IT IS FINE. 🙅
	       then +180 more   -> everything correct, cameras AND model. ✅
	       net rotation = +270 = >>> -90 <<< . FIRST GUESS HAD THE SIGN BACKWARDS.
	                                          THAT WAS THE ENTIRE MISTAKE.

	     🔍 AND LOOK: -90 is EXACTLY MOBL's r_y default_value. the number you need is
	        LITERALLY THE NUMBER IN THE BANNER. that is a very good sign that this is
	        understood and not just fitted.
	        ⚠️ BUT: observed ONCE, on ONE model. the sign correspondence between "the
	        default_value in the .osim" and "which way you physically turn the rig" is
	        NOT PROVEN. if a future model's banner says +40 deg, TRY BOTH SIGNS and
	        write down which one won. 📝

	     🚧 STILL OPEN — DO NOT TREAT AS SETTLED: nobody has checked these axes against
	        the VICON coordinate system. this was calibrated against WALL MARKERS only.
	        WHEN YOU ARE NEXT IN THE VICON ROOM, CHECK THIS BEFORE TRUSTING ANY NUMBER
	        THAT COMES OUT. needing a tweak there is EXPECTED, not a regression. 🧾

	     ============ WHY THIS IS NOT AUTOMATED (IT IS NOT LAZINESS) ============

	     R_GoGi has 3 DOF. tilt (2 DOF) is OBSERVABLE — gravity gives it to you. yaw
	     (1 DOF) IS NOT OBSERVABLE AT ALL: vio picks its world yaw arbitrarily and
	     there is no magnetometer. the missing DOF *MUST* come from outside the sensors.
	     imu_direction_axis below IS that mechanism, and it is why you are turning a rig
	     with your hands like it is 1997. THIS IS THE DESIGN, NOT A BODGE. 🤝

	     PROPER FIX, someday: calibrate against the ACTUAL pose instead of the default.
	     exact for the KUKA (it has joint encoders). for humans, default pose + "hold
	     still" is all we have, so the dance stays.

	     see also: the equally shouty block in testorama_lower_body.launch about
	     imu_ref_ori PARENTING. that one is a PITCH. this one is a YAW.
	     DIFFERENT AXIS. DIFFERENT BUG. DO NOT MERGE THEM. 🚫
	-->
	<arg name="imu_base_body"               default="pelvis" />
	<arg name="imu_direction_axis"          default="z" />
	<arg name="machine"             	default=""/>

	<arg name="use_position_markers"        default="false"/>
	<arg name="use_orientation_markers"     default="true"/>
	<!-- this is so stupid, but I don't know of another way of doing it -->
	<!-- also logging is bugged with ssh execution, so for these nodes we will have to read the logs!-->
	<arg name="point_getter_type"           default="tf"/>
	<arg name="ns"                          default=""/>
	<arg name="filter_output"             	default="true" />
	<group ns="$(arg ns)">
		<node pkg="osrt_ros" type="OnlineLowerLimb"     name="$(arg ik_node_name)" machine="$(arg machine)" output="log" if="$(eval arg('machine') != '')">
			<param name="point_getter_type"         value="$(arg point_getter_type)"/>
			<param name="use_position_markers"      value="$(arg use_position_markers)"/>
			<param name="use_orientation_markers"   value="$(arg use_orientation_markers)"/>
			<param name="/use_sim_time" 		value="$(arg use_sim_time)"/>
			<!-- param name="resample_period"               value="0.01" / -->
			<param name="model_file"                value="$(arg model_file)" />
			<!--param name="model_file"             value="scale/model_scaled.osim" / -->
			<param name="imu_base_body"             value="$(arg imu_base_body)" />


			<param name="visualise"                 value="$(arg visualise)"/>
			<!-- OK, this is confusing as hell-->
			<!-- but let's break it down. the tf_prefix is to allow for multiple skeletons from different parts to be shown-->
			<!-- OK, this is confusing as hell-->
			<!-- OK, this is confusing as hell-->
			<param name="tf_prefix" 		value="$(arg tf_prefix)"/>

			<!-- OK, this is confusing as hell-->
			<!-- however tf_frame_prefix is the source of tf, either imu or ar right now, that will be put before the name so we can have both of these at the same time. they could be shared, i think in the future, but this is more flexible.-->

			<param name="imu_tf_world_reference"    value="imu_ref_ori" />
			<!-- if you setup the next line to be the subject_heading, since currently this is the publication frame for the IMUs as well, then the heading values will not have any effect. -->
			<!--param name="imu_tf_world_reference"                 value="subject_heading" / -->
			<param name="tf_frame_prefix"           value="imu" />

			<param name="imu_direction_axis"        value="$(arg imu_direction_axis)" />
			<param name="rate"                      value="$(arg freq)" />
			<param name="logger_filename_ik"        value="_ik_$(arg name_tag)" />
			<param name="logger_filename_imus"      value="_imus_$(arg name_tag)" />
			<param name="data_save_dir"             value="/tmp" />

			<remap from="output"            	to="ik/output"/>
			<remap from="output_filtered"   	to="ik/output_filtered"/>

			<!-- Filter values for filtered output -->
			<param name="filter_output"             value="$(arg filter_output)" />
			<rosparam command="load" 		file="$(find osrt_ros)/config/filter.yaml"/>

			<param name="wait_to_start"     	value="$(arg wait_to_start)" />
			<!-- Debug options -->

			<!-- this is how you add vicon marker style stuff rn. I sort of invented a new standard here because of time crunch. Ideally I would use the package from ETH zurick for vicon and use the same standard so I could avoid doing this twice -->
			<param name="marker/tf_timeout"         value="0.01" />
			<param name="marker/tf_frame_prefix"    value="ar" />
			<!--param name="marker/world_tf_reference" value="imu_ref_ori" / -->
			<param name="marker/world_tf_reference" value="opensim_frame" />
			<!-- Currently the implementation only allows you to set the center of the AR marker to be exactly the mocap marker, you can either change the osim model or extend this to use points with a coordinate system to allow fixed rigid body translations -->

			<!--rosparam command="load" file="$(find vicon_rviz_markers)/config/$(arg model)_markers.yaml" param="marker/observation_order" / -->
			<param command="$(find osrt_ros)/scripts/generate_markers_yaml.py $(arg model_file)" name="marker/observation_order" type="yaml" />


		</node>

		<node pkg="osrt_ros" type="OnlineLowerLimb"     name="$(arg ik_node_name)" output="screen" if="$(eval arg('machine') == '' )" >
			<param name="point_getter_type"                   value="$(arg point_getter_type)"/>
			<param name="use_position_markers"                value="$(arg use_position_markers)"/>
			<param name="use_orientation_markers"             value="$(arg use_orientation_markers)"/>
			<param name="/use_sim_time" value="$(arg use_sim_time)"/>
			<!-- param name="resample_period"               value="0.01" / -->
			<param name="model_file"                value="$(arg model_file)" />
			<!--param name="model_file"             value="scale/model_scaled.osim" / -->
			<param name="imu_base_body"             value="$(arg imu_base_body)" />

			<param name="visualise"                 value="$(arg visualise)"/>
			<!-- OK, this is confusing as hell-->
			<!-- but let's break it down. the tf_prefix is to allow for multiple skeletons from different parts to be shown-->
			<!-- OK, this is confusing as hell-->
			<!-- OK, this is confusing as hell-->
			<param name="tf_prefix" value="$(arg tf_prefix)"/>

			<!-- OK, this is confusing as hell-->
			<!-- however tf_frame_prefix is the source of tf, either imu or ar right now, that will be put before the name so we can have both of these at the same time. they could be shared, i think in the future, but this is more flexible.-->
			<!--rosparam param="imu_observation_order" >['thorax','radius']</rosparam -->

		<param name="imu_tf_world_reference"            value="imu_ref_ori" />
		<!-- if you setup the next line to be the subject_heading, since currently this is the publication frame for the IMUs as well, then the heading values will not have any effect. -->
		<!--param name="imu_tf_world_reference"                 value="subject_heading" / -->
		<param name="tf_frame_prefix"           value="imu" />

		<param name="imu_direction_axis"                value="$(arg imu_direction_axis)" />
		<param name="rate"                              value="$(arg freq)" />
		<param name="logger_filename_ik"                value="_ik_$(arg name_tag)" />
		<param name="logger_filename_imus"              value="_imus_$(arg name_tag)" />
		<param name="data_save_dir"             value="/tmp" />

		<remap from="output"            to="ik/output"/>
		<remap from="output_filtered"   to="ik/output_filtered"/>

		<!-- Filter values for filtered output -->
		<param name="filter_output"             value="$(arg filter_output)" />
		<rosparam command="load" file="$(find osrt_ros)/config/filter.yaml"/>

		<param name="wait_to_start"     value="$(arg wait_to_start)" />
		<!-- Debug options -->

		<!-- this is how you add vicon marker style stuff rn. I sort of invented a new standard here because of time crunch. Ideally I would use the package from ETH zurick for vicon and use the same standard so I could avoid doing this twice -->
		<param name="marker/tf_timeout"         value="0.01" />
		<param name="marker/tf_frame_prefix"    value="ar" />
		<!--param name="marker/world_tf_reference" value="imu_ref_ori" / -->
		<param name="marker/world_tf_reference" value="opensim_frame" />
		<!-- Currently the implementation only allows you to set the center of the AR marker to be exactly the mocap marker, you can either change the osim model or extend this to use points with a coordinate system to allow fixed rigid body translations -->

		<param command="$(find osrt_ros)/scripts/generate_markers_yaml.py $(arg model_file)" name="marker/observation_order" type="yaml" />

	</node>
	<!-- param name="human_model" command="$(find osrt_ros)/human_publisher_mini_node $(arg model_file) 1> /dev/null 2> /dev/null; cat /tmp/converted_model.urdf"/ -->
</group>
																																																																																																																														</launch>

